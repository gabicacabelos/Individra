# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Graphify: todo el output es local, se regenera con el hook post-commit.
# No se committea para no ensuciar diffs — cada dev genera el suyo con: graphify extract . --code-only
graphify-out/

# Local agent artifacts
.claude/
scratch_artifact.json


# Respaldos locales de imagenes originales (pre-limpieza de cutout). No van al deploy.
/_backup-imagenes/
# Componente dado de baja, se conserva solo en local como red de seguridad
/src/components/_removed/
# Fotos de perfil personales: public/ se sirve publicamente
/public/perfil_linkedin/
